---
import AppShell from '../layouts/AppShell.astro';
import IntakeScreen from '../components/IntakeScreen';
import DailyLoopPanel from '../components/DailyLoopPanel';
import JdLibrary from '../components/JdLibrary';
---

<AppShell title="Intake" active="intake">
  <div class="mb-6">
    <h1 class="text-xl font-semibold text-text">Intake</h1>
    <p class="mt-1 text-sm text-text-dim">
      Paste a JD or URL, get a scorecard verdict, file it — or run a batch of candidates
      through the daily loop for review.
    </p>
  </div>

  <div class="flex flex-col gap-8">
    <IntakeScreen client:load />
    <DailyLoopPanel client:load />

    <section>
      <h2 class="mb-3 text-lg font-medium text-text">JD library</h2>
      <JdLibrary client:load />
    </section>
  </div>
</AppShell>
