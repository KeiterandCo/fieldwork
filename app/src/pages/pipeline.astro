---
import AppShell from '../layouts/AppShell.astro';
import PipelineBoard from '../components/PipelineBoard';
---

<AppShell title="Pipeline" active="pipeline">
  <div class="mb-6">
    <h1 class="text-xl font-semibold text-text">Pipeline</h1>
    <p class="mt-1 text-sm text-text-dim">Drag a card between columns to move its status.</p>
  </div>
  <PipelineBoard client:load />
</AppShell>
